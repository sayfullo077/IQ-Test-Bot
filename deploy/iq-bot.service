[Unit]
Description=IQ Test Telegram Bot
After=network.target postgresql.service redis.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/iq-bot
ExecStart=/opt/iq-bot/venv/bin/python -m bot
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=iq-bot

# Environment file (contains BOT_TOKEN, DATABASE_URL, etc.)
EnvironmentFile=/opt/iq-bot/.env

[Install]
WantedBy=multi-user.target
